#!/bin/sh
# halcora-layout — switch the desktop layout.
#
# This is the whole feature. Plasma's Global Theme machinery already installs
# several layouts side by side and swaps them non-interactively, so we
# orchestrate rather than implement.
#
#   halcora-layout win     Windows-style layout (the default)
#   halcora-layout macos   macOS-style layout
#   halcora-layout --list  list installed Global Themes
set -eu

win_id=org.halcora.lookandfeel.win
macos_id=org.halcora.lookandfeel.macos

apply=plasma-apply-lookandfeel
if ! command -v "$apply" >/dev/null 2>&1; then
    # Plasma 6 still ships the legacy binary name alongside the new one.
    apply=lookandfeeltool
fi
if ! command -v "$apply" >/dev/null 2>&1; then
    printf 'no plasma-apply-lookandfeel or lookandfeeltool found — is Plasma installed?\n' >&2
    exit 1
fi

case "${1:-}" in
    win|windows)
        id=$win_id
        ;;
    macos|mac)
        id=$macos_id
        ;;
    --list|-l|list)
        exec "$apply" --list
        ;;
    *)
        printf 'usage: %s win|macos|--list\n' "${0##*/}" >&2
        exit 2
        ;;
esac

# Check the id is actually installed before asking Plasma to apply it. Without
# this the only symptom is a KDE warning on a terminal the user may not have
# open, and "the layout did nothing" is indistinguishable from a broken script.
found=
for dir in /usr/share/plasma/look-and-feel "$HOME/.local/share/plasma/look-and-feel"; do
    if [ -d "$dir/$id" ]; then
        found=1
        break
    fi
done
if [ -z "$found" ]; then
    printf 'layout %s is not installed.\n' "$id" >&2
    printf 'Install the package that provides it (halcora-lookandfeel-win or\n' >&2
    printf 'halcora-lookandfeel-macos), or run %s --list to see what is.\n' "${0##*/}" >&2
    exit 1
fi

# --resetLayout replaces the panel layout with the one inside the theme package.
# Without it, plasma-apply-lookandfeel deliberately leaves the user's own panels
# alone — correct for browsing themes, wrong for switching layouts.
"$apply" --apply "$id" --resetLayout

# Window decoration and button positions live in kwinrc, so KWin has to re-read
# its configuration before the change is actually visible.
if command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
elif command -v qdbus >/dev/null 2>&1; then
    qdbus org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
fi

printf 'Layout: %s\n' "$id"
