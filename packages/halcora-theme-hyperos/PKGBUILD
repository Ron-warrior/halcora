# Maintainer: Halcora <noreply@github.com/Ron-warrior>
#
# The HyperOS palette: two colour schemes, and nothing else yet.
#
# docs/DESIGN.md says the palette lives only here, so that both layouts wear it
# without either layout package carrying a colour. That is why the layout
# packages strip ColorScheme= from their Global Themes and this package provides
# the schemes instead.
#
# Scope, stated plainly: this installs the palette and a recoloured window
# decoration. It does NOT yet ship a Plasma style or Kvantum style, so a desktop
# wearing these colours still has Fluent's (or Breeze's) shapes for its panels,
# menus and Qt widgets. ADR-4 says this package starts as a recolour of Fluent's
# geometry; that is done for the decoration and not for the rest, and the docs say
# so rather than letting "the HyperOS theme" imply more than it is.
#
# When it is attempted: Fluent's Plasma style lives in
# plasma/desktoptheme/Fluent/ (the `Fluent-dark` name is made by install.sh) and
# its files are .svgz, gzipped. sed over them silently matches nothing, so the
# recolour must gunzip, sed, gzip, and must take its source hex values from the
# decompressed files rather than from a screenshot.
#
# Nothing in this file has been built.

pkgname=halcora-theme-hyperos
pkgver=0.1.0
pkgrel=1
pkgdesc='Halcora HyperOS palette and window decoration (Plasma style still to come)'
arch=('any')
url='https://github.com/Ron-warrior/halcora'
license=('GPL-3.0-or-later')
depends=('plasma-workspace')
optdepends=('kwin: the Aurorae window decoration installed here')
source=("Fluent-kde::git+https://github.com/vinceliuice/Fluent-kde.git#commit=44794f29c89de994b0179aebabd2f5776c90d236")
sha256sums=('SKIP')

package() {
  # Installed from the repository rather than through source=: these files are
  # ours, not a download, and a checksum of a file sitting next to the PKGBUILD
  # verifies nothing. Same reasoning as halcora-layout.
  install -d "$pkgdir/usr/share/color-schemes"
  install -m644 "$startdir/color-schemes/HalcoraHyperOSLight.colors" \
    "$pkgdir/usr/share/color-schemes/"
  install -m644 "$startdir/color-schemes/HalcoraHyperOSDark.colors" \
    "$pkgdir/usr/share/color-schemes/"

  # The window decoration, recoloured from Fluent's. This is the one part of the
  # shape language that can be done without decompressing anything: Aurorae's
  # SVGs are plain, and their literals were read from upstream rather than
  # guessed — #dedede for the glyph, #ff8080 and #d35f5f for hover and press.
  #
  # The theme is renamed, not overwritten: writing over aurorae/Fluent-dark would
  # change any other desktop using Fluent, and would be undone by the next
  # package upgrade.
  local aur="$pkgdir/usr/share/aurorae/themes/HalcoraHyperOS"
  install -d "$(dirname "$aur")"
  cp -a "$srcdir/Fluent-kde/aurorae/Fluent-dark" "$aur"

  # Aurorae requires the rc file to be named after its directory.
  mv "$aur/Fluent-darkrc" "$aur/HalcoraHyperOSrc"

  sed -i \
    -e 's/#dedede/#ededf0/g' \
    -e 's/#ff8080/#d82d3a/g' \
    -e 's/#d35f5f/#b02430/g' \
    "$aur"/*.svg

  sed -i \
    -e 's/^Name=.*/Name=HalcoraHyperOS/' \
    -e 's/Fluent-dark/HalcoraHyperOS/g' \
    "$aur/metadata.desktop"

  # Kvantum, for Qt applications. Its palette lives in the .kvconfig, whose
  # GeneralColors section was read from upstream rather than guessed:
  # highlight #0078D4, text #444444, link #0057AE, visited #E040FB, and the
  # window/base/button greys. Those are what are remapped here.
  #
  # Honest limit: this changes the configurable colours — accent, text, links,
  # surfaces. Kvantum also draws widget elements from its .svg, whose greys are
  # baked in, so panels and buttons keep Fluent's own shading until that SVG is
  # recoloured. Both statements belong together.
  local kv="$pkgdir/usr/share/Kvantum/HalcoraHyperOS"
  cp -a "$srcdir/Fluent-kde/Kvantum/Fluent" "$kv"
  sed -i \
    -e 's/#F5F5F5/#F7F7FA/g' \
    -e 's/#f8f8f8/#FAFAFC/g' \
    -e 's/#f2f2f2/#F2F2F6/g' \
    -e 's/#f0f0f0/#EDEDF2/g' \
    -e 's/#c8c8c8/#D5D5DC/g' \
    -e 's/#e1e1e196/#E4E4EA96/g' \
    -e 's/#0078D474/#3482FF74/g' \
    -e 's/#0078D4/#3482FF/g' \
    -e 's/#444444/#1C1C1E/g' \
    -e 's/#333333/#24242A/g' \
    -e 's/#424242/#2E2E34/g' \
    -e 's/#242424/#1C1C1E/g' \
    -e 's/#0057AE/#3482FF/g' \
    -e 's/#E040FB/#7A5AF6/g' \
    "$kv/Fluent.kvconfig"
  mv "$kv/Fluent.kvconfig" "$kv/HalcoraHyperOS.kvconfig"
  # Kvantum requires the .svg to share the directory's name.
  if [ -f "$kv/Fluent.svg" ]; then
    mv "$kv/Fluent.svg" "$kv/HalcoraHyperOS.svg"
  fi
  if [ -f "$kv/FluentDark.svg" ]; then
    mv "$kv/FluentDark.svg" "$kv/HalcoraHyperOSDark.svg"
  fi
}
