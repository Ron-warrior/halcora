#!/bin/sh
# Launch Halcora's own installer in a window.
#
# The installer is a script. This runs it under pkexec inside Konsole, with the
# window titled for Halcora: a terminal in a named window is an honest interface
# for a program that asks questions and prints what it is doing. A graphical
# installer is a later job, and pretending otherwise by wrapping a few dialogs
# around the same script would hide the prompts it prints between them.
#
# Runs as the live user. pkexec elevates; the polkit rule in
# /etc/polkit-1/rules.d/49-halcora-live.rules allows exactly this program and
# nothing else, which is why the live account needs no password.
set -eu

installer=/usr/local/bin/halcora-install

if [ ! -x "$installer" ]; then
    command -v kdialog >/dev/null 2>&1 &&
        kdialog --title 'Install Halcora' --error \
            'The installer is missing from this image. That is a bug in the image, not something you did.'
    echo "halcora-installer: $installer not found" >&2
    exit 1
fi

# There is no X access problem here, unlike the Calamares launcher this replaces:
# the installer draws nothing. It needs a terminal, and Konsole provides one.
exec konsole --title "Install Halcora" --hold -e pkexec "$installer"
