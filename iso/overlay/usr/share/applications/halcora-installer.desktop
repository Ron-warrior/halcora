[Desktop Entry]
Type=Application
Name=Install Halcora
Comment=Install Halcora on this computer
# Through the wrapper, not pkexec directly: the wrapper grants root access to the
# X display and takes it away again afterwards, and says something if Calamares is
# missing rather than appearing to do nothing.
Exec=/usr/local/bin/halcora-installer
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
