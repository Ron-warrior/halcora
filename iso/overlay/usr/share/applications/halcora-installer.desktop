[Desktop Entry]
Type=Application
Name=Install Halcora
Comment=Install Halcora on this computer
# Through the launcher, which opens a Halcora-titled Konsole and runs the
# installer under pkexec. The installer is a script that asks questions and says
# what it is doing; a terminal is the honest window for it.
Exec=/usr/local/bin/halcora-installer
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
