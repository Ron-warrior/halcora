// Let the live account start the installer without a password.
//
// pkexec authenticates through polkit, and the live account has no password at
// all — autologin means nobody types one — so pkexec has nothing to ask for and
// refuses. Without this rule the installer's icon does nothing, which is
// indistinguishable from a broken image.
//
// The grant is as narrow as polkit allows: one user, one action, and only when
// the program is the installer's root helper — a fixed path, not `/usr/bin/env`,
// which is why the helper exists.
//
// This file is one of the live-session leftovers the installer has to remove
// (iso/README gap 5).

polkit.addRule(function (action, subject) {
    if (subject.user !== "live") {
        return null;
    }
    if (action.id !== "org.freedesktop.policykit.exec") {
        return null;
    }
    var program = action.lookup("program");
    if (program === "/usr/local/bin/halcora-installer-root") {
        return polkit.Result.YES;
    }
    return null;
});
