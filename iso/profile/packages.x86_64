# Halcora live image package set.
#
# This list ends up BOTH in the live session and, because the installer unpacks
# the live squashfs, on the installed system. There is no separate target list,
# so anything a user needs after installing has to be here.
#
# Deliberately absent: archinstall (we ship Calamares) and releng's rescue
# toolchain (irssi, nmap, testdisk, clonezilla and ~40 others). zsh is absent
# too, which is why /etc/passwd does not point root at it.

# --- base system ---
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
arch-install-scripts
sudo
nano

# --- filesystems and partitioning ---
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfsprogs
parted
gptfdisk
squashfs-tools

# --- boot ---
grub
efibootmgr
syslinux

# --- networking ---
networkmanager
iwd
wpa_supplicant

# --- audio ---
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber

# --- desktop ---
# plasma-meta pulls plasma-nm, plasma-pa, discover, print-manager, spectacle,
# xdg-desktop-portal-kde, kscreenlocker and the rest of the Plasma set, so only
# the extras are listed explicitly.
plasma-meta
sddm
xdg-user-dirs
xdg-utils
konsole
dolphin
kate
ark
gwenview
okular
kcalc
udisks2
gvfs
gvfs-mtp

# --- bluetooth ---
bluez
bluez-utils
bluez-obex

# --- printing ---
cups

# --- applications ---
firefox

# --- fonts ---
noto-fonts
noto-fonts-emoji
ttf-liberation
inter-font

# --- store ---
flatpak
packagekit-qt6

# --- installer ---
# Calamares is not in the Arch repositories, so CI builds it and iso/build.sh
# overlays it. These are the libraries it links against at runtime, plus polkit
# so it can elevate with pkexec, and xorg-xhost so that the root process is
# allowed to open the live session's X display at all.
polkit
xorg-xhost
kcoreaddons
kpmcore
libpwquality
qt6-declarative
qt6-svg
qt6-translations
yaml-cpp
